          marginBottom: '2rem',
          fontWeight: 400,
        }}>
          Dates book up fast — especially weekends. Check yours before it&apos;s gone.
        </p>

        <div style={{
          display: 'flex',
          gap: '0',
          maxWidth: '480px',
          margin: '0 auto',
          boxShadow: '0 2px 24px rgba(0,0,0,0.3)',
        }}>
          <input
            type="date"
            value={date}
            onChange={e => { setDate(e.target.value); setStatus('idle') }}
            min={today}
            max={maxDate}
            style={{
              flex: 1,
              fontFamily: 'var(--font-body)',
              fontSize: '0.9rem',
              fontWeight: 400,
              color: date ? 'var(--color-sand)' : 'rgba(237,232,223,0.35)',
              background: 'rgba(237,232,223,0.06)',
              border: '1.5px solid rgba(237,232,223,0.12)',
              borderRight: 'none',
              padding: '0.9rem 1.25rem',
              outline: 'none',
              borderRadius: '3px 0 0 3px',
              colorScheme: 'dark',
            }}
          />
          <button
            onClick={check}
            disabled={!date || status === 'loading'}
            style={{
              fontFamily: 'var(--font-body)',
              fontSize: '0.68rem',
              fontWeight: 700,
              letterSpacing: '0.14em',
              textTransform: 'uppercase',
              color: '#fff',
              background: !date ? 'rgba(212,133,106,0.4)' : 'var(--color-amber)',
              border: 'none',
              padding: '0.9rem 1.75rem',
              borderRadius: '0 3px 3px 0',
              cursor: !date ? 'not-allowed' : 'pointer',
              whiteSpace: 'nowrap',
              transition: 'background 0.2s ease',
              flexShrink: 0,
            }}
          >
            {status === 'loading' ? '...' : 'Check'}
          </button>
        </div>

        {info && (
          <div style={{
            marginTop: '1.25rem',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center',
            gap: '1rem',
          }}>
            <p style={{
              fontFamily: 'var(--font-body)',
              fontSize: '0.88rem',
              fontWeight: 600,
              color: info.color,
              letterSpacing: '0.01em',
            }}>
              {info.text}
            </p>
            {status === 'available' && date && (
              <Link
                href={`/book?date=${date}`}
                style={{
                  fontFamily: 'var(--font-body)',
                  fontSize: '0.72rem',
                  fontWeight: 700,
                  letterSpacing: '0.14em',
                  textTransform: 'uppercase',
                  color: '#fff',
                  background: 'var(--color-amber)',
                  padding: '0.85rem 2.25rem',
                  borderRadius: '3px',
                  textDecoration: 'none',
                  display: 'inline-block',
                }}
              >
                Book This Date →
              </Link>
            )}
            {status === 'limited' && date && (
              <Link
                href={`/book?date=${date}`}
                style={{
                  fontFamily: 'var(--font-body)',
                  fontSize: '0.72rem',
                  fontWeight: 700,
                  letterSpacing: '0.14em',
                  textTransform: 'uppercase',
                  color: 'var(--color-charcoal)',
                  background: 'var(--color-sand)',
                  padding: '0.85rem 2.25rem',
                  borderRadius: '3px',
                  textDecoration: 'none',
                  display: 'inline-block',
                }}
              >
                Check Remaining Slots →
              </Link>
            )}
          </div>
        )}
      </div>
    </div>
  )
}

