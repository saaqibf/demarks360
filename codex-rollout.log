-        <p style={{ fontFamily: 'var(--font-body)', fontSize: '0.68rem', color: 'rgba(237,232,223,0.18)', fontWeight: 400 }}>
+        <p className="t-label" style={{ color: 'var(--color-muted-light)' }}>
           Calgary, Alberta, Canada
         </p>
       </div>
+
+      <style>{`
+        @media (max-width: 860px) {
+          .footer-cinema-grid {
+            grid-template-columns: 1fr 1fr !important;
+            padding: 3.5rem 1.5rem 2rem !important;
+          }
+          .footer-cinema-base {
+            padding: 1.5rem !important;
+          }
+        }
+        @media (max-width: 560px) {
+          .footer-cinema-grid {
+            grid-template-columns: 1fr !important;
+          }
+        }
+      `}</style>
     </footer>
   )
 }
+
+function FooterColumn({ title, links }: { title: string; links: { label: string; href: string }[] }) {
+  return (
+    <div>
+      <p className="t-label" style={{
+        color: 'var(--color-amber)',
+        marginBottom: '1rem',
+      }}>
+        {title}
+      </p>
+      {links.map(link => (
+        <FooterAnchor key={link.label} href={link.href}>
+          {link.label}
+        </FooterAnchor>
+      ))}
+    </div>
+  )
+}
+
+function FooterAnchor({
+  href,
+  children,
+  external = false,
+  muted = false,
+}: {
+  href: string
+  children: React.ReactNode
+  external?: boolean
+  muted?: boolean
+}) {
+  const style = {
+    display: 'block',
+    fontFamily: 'var(--font-body)',
+    fontSize: '0.92rem',
+    color: muted ? 'var(--color-muted)' : 'var(--color-muted-light)',
+    textDecoration: 'none',
+    padding: '0.28rem 0',
+    fontWeight: 400,
+    transition: 'color 0.2s ease',
+  }
+
+  if (href.startsWith('/')) {
+    return <Link href={href} style={style}>{children}</Link>
+  }
+
+  return (
+    <a
+      href={href}
+      target={external ? '_blank' : undefined}
+      rel={external ? 'noopener noreferrer' : undefined}
+      style={style}
+    >
+      {children}
+    </a>
+  )
+}
