'use client'
import Link from 'next/link'
import { useState, useEffect } from 'react'

export function SiteNav() {
  const [open, setOpen] = useState(false)
  const [active, setActive] = useState('')

  useEffect(() => {
    const ids = ['how-it-works', 'pricing', 'gallery', 'faq']
    const obs = new IntersectionObserver(
      entries => entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id) }),
      { rootMargin: '-20% 0px -60% 0px' }
    )
    ids.forEach(id => { const el = document.getElementById(id); if (el) obs.observe(el) })
    return () => obs.disconnect()
  }, [])

  const links = ['How It Works', 'Pricing', 'Gallery', 'FAQ']

  return (
    <header style={{
      position: 'fixed',
      top: 0,
      left: 0,
      right: 0,
      zIndex: 1000,
      pointerEvents: 'none',
    }}>
      <nav style={{
        maxWidth: '1280px',
        margin: '0 auto',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        height: '72px',
        padding: '0 3rem',
        gap: '2rem',
        pointerEvents: 'auto',
        background: 'color-mix(in srgb, var(--color-charcoal) 82%, transparent)',
        backdropFilter: 'blur(20px)',
        WebkitBackdropFilter: 'blur(20px)',
        borderBottom: '1px solid var(--color-border-dark)',
      }}>
        <Link href="/" style={{ textDecoration: 'none', flexShrink: 0 }}>
          <span style={{
            fontFamily: 'var(--font-wordmark)',
            fontSize: '1.45rem',
            fontWeight: 400,
            letterSpacing: '0.04em',
            color: 'var(--color-sand)',
            lineHeight: 1,
          }}>
            Demarks<em style={{ color: 'var(--color-amber-light)', fontStyle: 'italic' }}>360</em>
          </span>
        </Link>

        <div className="nav-links-desktop" style={{ display: 'flex', alignItems: 'center', gap: '2.25rem' }}>
          {links.map(label => {
            const id = label.toLowerCase().replace(/\s+/g, '-')
            const isActive = active === id
            return (
              <a
                key={label}
                href={`#${id}`}
                className="nav-link"
                style={{
                  fontFamily: 'var(--font-body)',
                  fontSize: '0.68rem',
                  fontWeight: isActive ? 600 : 500,
                  letterSpacing: '0.12em',
                  textTransform: 'uppercase',
                  color: isActive ? 'var(--color-sand)' : 'var(--color-muted-light)',
                  textDecoration: 'none',
                  whiteSpace: 'nowrap',
                  position: 'relative',
                  paddingBottom: '3px',
                }}
              >
                {label}
                {isActive && (
                  <span style={{
                    position: 'absolute',
                    bottom: 0,
                    left: 0,
                    right: 0,
                    height: '1px',
                    background: 'var(--color-amber-light)',
                  }} />
                )}
              </a>
            )
          })}

          <Link href="/admin-login" className="nav-link" style={{
            fontFamily: 'var(--font-body)',
            fontSize: '0.68rem',
            fontWeight: 500,
            letterSpacing: '0.12em',
            textTransform: 'uppercase',
            color: 'var(--color-muted-light)',
            textDecoration: 'none',
            whiteSpace: 'nowrap',
            opacity: 0.55,
          }}>
            Admin
          </Link>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', flexShrink: 0 }}>
          <Link href="/book" className="btn-primary nav-book-btn" style={{
            padding: '0.75rem 1.75rem',
          }}>
            Book now
          </Link>

          <button
            onClick={() => setOpen(o => !o)}
            className="nav-hamburger"
            aria-label={open ? 'Close menu' : 'Open menu'}
            aria-expanded={open}
            style={{
              background: 'none',
              border: 'none',
              cursor: 'pointer',
              padding: '0.5rem',
              display: 'none',
              minHeight: '44px',
              alignItems: 'center',
              justifyContent: 'center',
              flexDirection: 'column',
              gap: '5px',
            }}
          >
            <span style={{ display: 'block', width: '22px', height: '1.5px', background: 'var(--color-sand)' }} />
            <span style={{ display: 'block', width: '16px', height: '1.5px', background: 'var(--color-sand)' }} />
          </button>
        </div>
      </nav>

      {open && (
        <div style={{
          background: 'color-mix(in srgb, var(--color-charcoal) 96%, transparent)',
          borderBottom: '1px solid var(--color-border-dark)',
          backdropFilter: 'blur(20px)',
          pointerEvents: 'auto',
        }}>
          <div style={{ maxWidth: '1280px', margin: '0 auto', padding: '0.5rem 1.5rem 1rem' }}>
            {links.map(label => (
              <a
                key={label}
                href={`#${label.toLowerCase().replace(/\s+/g, '-')}`}
                onClick={() => setOpen(false)}
                style={{
                  display: 'block',
                  fontFamily: 'var(--font-body)',
                  fontSize: '0.75rem',
                  fontWeight: 600,
                  letterSpacing: '0.1em',
                  textTransform: 'uppercase',
                  color: 'var(--color-sand)',
                  textDecoration: 'none',
                  padding: '0.85rem 0',
                  borderBottom: '1px solid var(--color-border-dark)',
                }}
              >
                {label}
              </a>
            ))}
            <Link
              href="/admin-login"
              onClick={() => setOpen(false)}
              style={{
                display: 'block',
                fontFamily: 'var(--font-body)',
                fontSize: '0.75rem',
                fontWeight: 600,
                letterSpacing: '0.1em',
                textTransform: 'uppercase',
                color: 'var(--color-muted-light)',
                textDecoration: 'none',
                padding: '0.85rem 0',
                borderBottom: '1px solid var(--color-border-dark)',
              }}
            >
              Admin
            </Link>
            <div style={{ paddingTop: '1rem' }}>
              <Link href="/book" className="btn-primary" onClick={() => setOpen(false)} style={{
                display: 'block',
                textAlign: 'center',
              }}>
                Book now
              </Link>
            </div>
          </div>
        </div>
      )}

      <style>{`
        .nav-link:hover {
          color: var(--color-sand) !important;
        }
        @media (max-width: 768px) {
          nav {
            padding: 0 1.5rem !important;
          }
          .nav-links-desktop { display: none !important; }
          .nav-hamburger { display: flex !important; }
          .nav-book-btn { display: none !important; }
        }
      `}</style>
    </header>
  )
}
import Link from 'next/link'

const bookLinks = [
  { label: 'Check your date', href: '#pricing' },
  { label: 'Book now', href: '/book' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'FAQ', href: '#faq' },
]

const eventLinks = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Birthdays', href: '/book' },
  { label: 'Weddings', href: '/book' },
]

export function SiteFooter() {
  const year = new Date().getFullYear()

  return (
    <footer style={{
      background: 'var(--color-charcoal-2)',
      borderTop: '1px solid var(--color-border-dark)',
    }}>
      <div className="footer-cinema-grid" style={{
        maxWidth: '1240px',
        margin: '0 auto',
        padding: '4.5rem 3rem 3rem',
        display: 'grid',
        gridTemplateColumns: '1.4fr 1fr 1fr 1fr',
        gap: '3rem',
      }}>
        <div>
          <Link href="/" style={{ textDecoration: 'none' }}>
            <span style={{
              fontFamily: 'var(--font-wordmark)',
              fontSize: '1.5rem',
              fontWeight: 400,
              color: 'var(--color-sand)',
              letterSpacing: '0.04em',
              lineHeight: 1,
            }}>
              Demarks<em style={{ color: 'var(--color-amber-light)', fontStyle: 'italic' }}>360</em>
            </span>
          </Link>
          <p className="t-body-dark" style={{
            color: 'var(--color-muted-light)',
            marginTop: '1.25rem',
            maxWidth: '30ch',
          }}>
            Calgary&apos;s 360 video booth for cinematic slow-motion moments, same-day galleries, and guest-ready clips.
          </p>
        </div>

        <FooterColumn title="Book" links={bookLinks} />
        <FooterColumn title="Events" links={eventLinks} />
        <div>
          <p className="t-label" style={{
            color: 'var(--color-amber)',
            marginBottom: '1rem',
          }}>
            Contact
          </p>
          <FooterAnchor href="https://instagram.com/demarks360" external>
            @demarks360
          </FooterAnchor>
          <FooterAnchor href="/privacy">Privacy policy</FooterAnchor>
          <FooterAnchor href="/terms">Terms of service</FooterAnchor>
          <FooterAnchor href="/admin-login" muted>Admin</FooterAnchor>
        </div>
      </div>

      <div className="footer-cinema-base" style={{
        maxWidth: '1240px',
        margin: '0 auto',
        padding: '1.5rem 3rem 2rem',
        display: 'flex',
        justifyContent: 'space-between',
        gap: '1rem',
        flexWrap: 'wrap',
        borderTop: '1px solid var(--color-border-dark)',
      }}>
        <p className="t-label" style={{ color: 'var(--color-muted-light)' }}>
          &copy; {year} Demarks 360. All rights reserved.
        </p>
        <p className="t-label" style={{ color: 'var(--color-muted-light)' }}>
          Calgary, Alberta, Canada
        </p>
      </div>

      <style>{`
        @media (max-width: 860px) {
          .footer-cinema-grid {
            grid-template-columns: 1fr 1fr !important;
            padding: 3.5rem 1.5rem 2rem !important;
          }
          .footer-cinema-base {
            padding: 1.5rem !important;
          }
        }
        @media (max-width: 560px) {
          .footer-cinema-grid {
            grid-template-columns: 1fr !important;
          }
        }
      `}</style>
    </footer>
  )
}

function FooterColumn({ title, links }: { title: string; links: { label: string; href: string }[] }) {
  return (
    <div>
      <p className="t-label" style={{
        color: 'var(--color-amber)',
        marginBottom: '1rem',
      }}>
        {title}
      </p>
      {links.map(link => (
        <FooterAnchor key={link.label} href={link.href}>
          {link.label}
        </FooterAnchor>
      ))}
    </div>
  )
}

function FooterAnchor({
  href,
  children,
  external = false,
  muted = false,
}: {
  href: string
  children: React.ReactNode
  external?: boolean
  muted?: boolean
}) {
  const style = {
    display: 'block',
    fontFamily: 'var(--font-body)',
    fontSize: '0.92rem',
    color: muted ? 'var(--color-muted)' : 'var(--color-muted-light)',
    textDecoration: 'none',
    padding: '0.28rem 0',
    fontWeight: 400,
    transition: 'color 0.2s ease',
  }

  if (href.startsWith('/')) {
    return <Link href={href} style={style}>{children}</Link>
  }

  return (
    <a
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      style={style}
    >
      {children}
    </a>
  )
}

