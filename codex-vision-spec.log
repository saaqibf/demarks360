/* Bodoni Moda (wordmark/display/headings) + Figtree (body/UI) — Golden Hour Cinema */
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400;1,6..96,500&family=Figtree:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@theme {
  /* ── Golden Hour Cinema palette ── */
  --color-sand:         #F5EFE2;
  --color-sand-2:       #EFE6D2;
  --color-sand-3:       #FAF6EC;
  --color-charcoal:     #141009;
  --color-charcoal-2:   #1A140B;
  --color-charcoal-3:   #221A0F;
  --color-text:         #1C1610;
  --color-text-light:   #F3EAD9;
  --color-muted:        #7A6C52;
  --color-muted-light:  #B9AD97;
  --color-amber:        #C9913F;
  --color-amber-light:  #E8B25C;
  --color-border-dark:  rgba(243,234,217,0.10);
  --color-border-light: rgba(28,22,16,0.12);

  /* ── Font stack ── */
  --font-wordmark: 'Bodoni Moda', Georgia, serif;
  --font-display: 'Bodoni Moda', Georgia, serif;
  --font-serif:   'Bodoni Moda', Georgia, serif;
  --font-body:    'Figtree', system-ui, sans-serif;
  --font-ui:      'Figtree', system-ui, sans-serif;

  /* ── Type scale — perfect fourth (1.333×), fluid headings ── */
  /* xs   → 0.75rem  (12px) labels, legal                    */
  /* sm   → 1rem     (16px) body minimum                     */
  /* md   → 1.333rem (21px) card headings                    */
  /* lg   → clamp(1.5rem, 2.5vw, 2rem)   section sub-heads  */
  /* xl   → clamp(2rem, 3.5vw, 2.667rem) section headings   */
  /* 2xl  → clamp(2.8rem, 5vw, 4rem)     hero               */
  /* 3xl  → clamp(3.5rem, 7vw, 5.5rem)   display            */
  --text-xs:      0.75rem;
  --text-sm:      0.875rem;
  --text-base:    1rem;
  --text-md:      1.333rem;
  --text-lg:      clamp(1.5rem, 2.5vw, 2rem);
  --text-xl:      clamp(2rem, 3.5vw, 2.667rem);
  --text-2xl:     clamp(2.8rem, 5vw, 4rem);
  --text-3xl:     clamp(3.5rem, 7vw, 5.5rem);

  /* ── Aliases for booking/gallery/admin surfaces ── */
  --color-ink:      #141009;
  --color-surface:  #1A140B;
  --color-surface-2:#221A0F;
}

* { box-sizing: border-box; }
html, body { overflow-x: hidden; max-width: 100vw; }

body {
  font-family: var(--font-body);
  font-size: 1rem;          /* 16px minimum — never below this */
  font-weight: 400;
  line-height: 1.7;
  background: var(--color-sand);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-kerning: normal;
}

/* ─── Typography roles ───────────────────────────────────────────── */

/* Display — hero headlines, major section openers */
.t-display {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -0.015em;
  text-transform: none;
}
.t-display em, .t-heading em, .t-subheading em {
  font-style: italic;
  color: var(--color-amber-light);
}

/* Heading — section headings */
.t-heading {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 400;
  line-height: 1.02;
  letter-spacing: -0.01em;
  text-transform: none;
}

/* Sub-heading — card titles, step titles */
.t-subheading {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: 0;
  text-transform: none;
}

/* Body — all paragraph copy, max 65ch */
.t-body {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.75;
  max-width: 65ch;        /* impeccable line-length cap */
}

/* Body on dark backgrounds — slightly looser for reverse-contrast legibility */
.t-body-dark {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.8;
  max-width: 65ch;
}

/* Label — eyebrows, section kickers, stat labels */
.t-label {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  line-height: 1;
}

/* UI — buttons, nav, small interactive text */
.t-ui {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

/* ─── Reveal scroll animation ───────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.8s cubic-bezier(.16,1,.3,1), transform 0.8s cubic-bezier(.16,1,.3,1);
}
.reveal.visible { opacity: 1; transform: translateY(0); }
@media (prefers-reduced-motion: reduce) { .reveal { transition: none; } }

/* ─── Hero animations ────────────────────────────────────────────── */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.hero-label    { animation: fade-up 0.7s cubic-bezier(.16,1,.3,1) 0.15s both; }
.hero-headline { animation: fade-up 0.9s cubic-bezier(.16,1,.3,1) 0.30s both; }
.hero-sub      { animation: fade-up 0.8s cubic-bezier(.16,1,.3,1) 0.50s both; }
.hero-ctas     { animation: fade-up 0.8s cubic-bezier(.16,1,.3,1) 0.65s both; }
.hero-video    { animation: fade-in 1.4s ease 0s both; }

/* ─── Buttons ────────────────────────────────────────────────────── */
.btn-primary {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--color-charcoal);
  background: var(--color-amber-light);
  padding: 0.95rem 2.5rem;
  border-radius: 999px;
  text-decoration: none;
  display: inline-block;
  transition: transform 0.35s cubic-bezier(.2,.8,.2,1), box-shadow 0.35s ease;
  border: none;
  cursor: pointer;
  min-height: 44px;
}
.btn-primary:hover { transform: scale(1.04); box-shadow: 0 12px 44px rgba(232,178,92,0.35); }

.btn-secondary {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--color-text);
  background: transparent;
  padding: 0.95rem 2.5rem;
  border-radius: 999px;
  text-decoration: none;
  display: inline-block;
  transition: background 0.3s ease, color 0.3s ease;
  border: 1px solid rgba(28,22,16,0.3);
  cursor: pointer;
  min-height: 44px;
}
.btn-secondary:hover { background: var(--color-charcoal); color: var(--color-text-light); }

.btn-ghost {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--color-text-light);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  opacity: 0.55;
  transition: opacity 0.2s ease;
}
.btn-ghost:hover { opacity: 1; }

/* ─── Section spacing — varied for rhythm, not uniform ──────────── */
.sec-pad        { padding: 7rem 3rem; }
.sec-pad-sm     { padding: 4rem 3rem; }
.sec-pad-lg     { padding: 9rem 3rem; }
@media (max-width: 768px) {
  .sec-pad    { padding: 5rem 1.5rem; }
  .sec-pad-sm { padding: 3rem 1.5rem; }
  .sec-pad-lg { padding: 6rem 1.5rem; }
}

/* ─── Nav links ──────────────────────────────────────────────────── */
.nav-link {
  transition: color 0.18s ease;
  cursor: pointer;
  text-decoration: none;
}
.nav-link:hover  { color: var(--color-charcoal) !important; }
.nav-link-active { color: var(--color-charcoal) !important; font-weight: 700 !important; }

/* ─── Touch targets ──────────────────────────────────────────────── */
button, a, [role="button"] { min-height: 44px; }

/* ─── Events list (redesigned) ───────────────────────────────────── */
.events-list {
  margin-top: 0;
}

/* ─── How It Works (redesigned) ─────────────────────────────────── */
.hiw-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}
@media (max-width: 768px) {
  .hiw-steps { grid-template-columns: 1fr; }
}

/* ─── Gallery grid ───────────────────────────────────────────────── */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  margin-top: 2.5rem;

