+
+function normalizeEventType(value: string | null): string {
+  if (!value) return ''
+  const normalized = value.trim().replace(/[-_]+/g, ' ').toLowerCase()
+  return EVENT_TYPE_ALIASES[normalized] ?? value.trim()
+}
