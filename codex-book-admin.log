            ))}
          </select>
        </div>

        <div>
          <label style={labelStyle}>Event Type</label>
          <select
            style={{ ...inputStyle, cursor: 'pointer' }}
            value={dropdownValue}
            onChange={e => {
              if (e.target.value === 'Other') {
                onChange({ eventType: ' ' })
              } else {
                onChange({ eventType: e.target.value })
              }
            }}
          >
            <option value="">Select event type…</option>
            {EVENT_TYPES.map(t => (
              <option key={t} value={t}>{t}</option>
